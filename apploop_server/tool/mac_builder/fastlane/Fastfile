default_platform(:ios)

platform :ios do
  desc 'Build and upload to TestFlight (internal testers only)'
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID'),
      issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      key_content: ENV.fetch('ASC_PRIVATE_KEY'),
      is_key_content_base64: false,
      duration: 1200,
      in_house: false
    )

    # BUILD_NUMBER comes from AppLoop (latest on TestFlight + 1).
    increment_build_number(
      build_number: ENV.fetch('BUILD_NUMBER'),
      xcodeproj: 'Runner.xcodeproj'
    )

    setup_ci if is_ci

    build_app(
      project: 'Runner.xcodeproj',
      scheme: 'Runner',
      export_method: 'app-store',
      xcargs: '-allowProvisioningUpdates'
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
      uses_non_exempt_encryption: false,
      changelog: File.read('changelog.txt')
    )
  end

  desc 'Retry uploading an already-built .ipa (no rebuild)'
  lane :retry_upload do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID'),
      issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      key_content: ENV.fetch('ASC_PRIVATE_KEY'),
      is_key_content_base64: false,
      duration: 1200,
      in_house: false
    )
    ipa_path = ENV.fetch('IPA_PATH')
    UI.user_error!("IPA not found at #{ipa_path}") unless File.exist?(ipa_path)
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
      uses_non_exempt_encryption: false
    )
  end
end
